# Copia este archivo a .env y ajusta los valores. .env está en .gitignore.
# El código lee las variables del entorno (no carga .env por sí solo): expórtalas
# en tu shell o con tu IDE. Sin ellas se usan las rutas por defecto del repo.

# Rutas (por defecto: data/, reports/ y freshmart-lake/ en la raíz del repo)
FRESHMART_DATA_DIR=
FRESHMART_REPORTS_DIR=
FRESHMART_LAKE_DIR=

# Nivel de log: DEBUG, INFO, WARNING, ERROR
FRESHMART_LOG_LEVEL=INFO

# Alertas de días sin datos. URL del Incoming Webhook de Slack (nunca la real aquí).
SLACK_WEBHOOK_URL=
